{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true, // <-- 允许导入.json文件，这是我们需要的关键配置
    "esModuleInterop": true,    // <-- 同样重要，确保模块导入的兼容性
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"] // 配置 '@' 别名，使其指向 'src' 目录
    },
    "types": [
      "@dcloudio/types" // 为 uni-app 提供类型支持
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ],
  "exclude": ["node_modules", "dist"]
}
